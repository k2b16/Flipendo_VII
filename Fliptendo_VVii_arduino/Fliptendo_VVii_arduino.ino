#include "pins_and_structs.h"
#include "utils.h"
#include "screen.h"
#include "buzzer.h"
#include "game.h"

/* BEGIN variables */
uint32_t delay_ms = 100;
unsigned long updateLastTime = 0;
/* END variables */

/* BEGIN main functions */
void setup() {
  setup_pins();

  set_columns_gnd();
  shift_out_all_rows_nc();

  Serial.begin(115200);
  delay(500);
  Serial.println("ESP32-S3 started");

  beep_bootup_sound();
}


/* main loop function */
void loop() {
  //buzz_buzzer();
  user_led_blink();

  if (millis() - updateLastTime >= delay_ms) {
    updateLastTime = millis();
    game();
  }
}
/* END main functions */
